{
  "name": "@marcalexiei/devtools-wiki",
  "private": true,
  "version": "1.0.0",
  "description": "Static site with a list of development resources",
  "keywords": [],
  "author": "Marco Pasqualetti @marcalexiei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcalexiei/devtools-wiki.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "scripts": {
    "dev": "vite",
    "dev:typecheck": "pnpm run typecheck -- --watch",
    "build": "vite build",
    "build:preview": "pnpm run build && vite preview",
    "test": "vitest",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "validate": "pnpm run \"/^(build|lint|format|typecheck)$/\" && pnpm run test --run"
  },
  "dependencies": {
    "@solidjs/router": "0.15.3",
    "@tanstack/solid-query": "5.83.0",
    "solid-js": "1.9.7",
    "zod": "4.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@marcalexiei/biome-config": "1.2.1",
    "@solidjs/testing-library": "0.8.10",
    "@testing-library/jest-dom": "6.6.4",
    "@types/node": "26.6.6",
    "happy-dom": "18.0.1",
    "sass-embedded": "1.89.2",
    "typescript": "5.8.3",
    "vite": "7.0.6",
    "vite-plugin-solid": "2.11.12",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
